---
interface Props {
  /** Renders a link when set, otherwise a <button>. */
  href?: string;
  /** primary = lavender, alt = sage (old DeeDee button), ghost = outline */
  variant?: 'primary' | 'alt' | 'ghost';
  type?: 'button' | 'submit';
}
const { href, variant = 'primary', type = 'button' } = Astro.props;
---

{
  href ? (
    <a class:list={['btn', variant]} href={href}><slot /></a>
  ) : (
    <button class:list={['btn', variant]} type={type}><slot /></button>
  )
}

<style>
  /* Old site button: rounded 12px, bold white text, soft drop shadow that grows on hover.
     Text is 19px/700 so white on lavender meets WCAG contrast for large text. */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    font: inherit;
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    border-radius: var(--radius-sm);
    border: 1.5px solid transparent;
    box-shadow: var(--shadow-btn);
    cursor: pointer;
  }
  .btn:hover {
    padding-inline: 1.3rem;
    box-shadow: var(--shadow-btn-hover);
  }
  .primary { background: var(--c-primary); color: var(--c-text); }
  .primary:hover { color: var(--c-text); background: #7d79c9; }
  .alt { background: var(--c-sage-dark); color: var(--c-bg); }
  .alt:hover { color: var(--c-bg); background: var(--c-sage); }
  .ghost {
    background: var(--c-surface);
    color: var(--c-text);
    border-color: var(--c-rule-strong);
    box-shadow: none;
  }
  .ghost:hover {
    color: var(--c-text);
    border-color: var(--c-secondary);
    box-shadow: none;
  }
</style>
