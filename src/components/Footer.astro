---
import { site } from '../site';

const year = new Date().getFullYear(); // computed at build
const emailIsSet = site.email.includes('@');
---

<footer class="site-footer">
  <div class="container inner">
    <div class="left">
      {site.signOff && <p class="sign-off">{site.signOff}</p>}
    </div>
    <div class="right">
      <ul class="links">
        <li>
          {emailIsSet ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span class="todo">{site.email}</span>}
        </li>
        <li><a href={site.github} rel="me">GitHub</a></li>
      </ul>
      <p class="copy">&copy; {year}</p>
    </div>
  </div>
</footer>

<style>
  /* Old site footer: lavender-gray text, sign-off left, contact right */
  .site-footer {
    margin-top: var(--sp-8);
    border-top: 1px solid var(--c-cream);
    color: var(--c-secondary);
    font-size: var(--fs-sm);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: var(--sp-4);
    padding-block: var(--sp-6);
  }
  p { margin: 0; }
  .right { text-align: right; }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--sp-1) var(--sp-5);
    margin: 0 0 var(--sp-2);
    padding: 0;
    list-style: none;
  }
  .links a {
    color: var(--c-text);
    text-decoration: none;
  }
  .links a:hover { text-decoration: underline; }
  .copy {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking);
    color: var(--c-text);
  }
  .todo {
    font-size: var(--fs-xs);
    color: var(--c-terracotta);
    border: 1px dashed var(--c-terracotta);
    border-radius: 6px;
    padding: 0 var(--sp-2);
  }
  @media (max-width: 36rem) {
    .inner { grid-template-columns: 1fr; text-align: left; }
    .right { text-align: left; }
    .links { justify-content: flex-start; }
  }
</style>
