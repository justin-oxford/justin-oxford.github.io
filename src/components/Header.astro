---
import { site } from '../site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {site.nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Old site: page title top-left in light cream, nav centered with a 3px underline */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
    padding-block: var(--sp-5) var(--sp-4);
  }
  .brand {
    font-size: 1.25rem;
    font-weight: 300;
    color: rgb(255 255 234 / 0.75); /* $lite-shade-col at 75% */
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover { color: var(--c-cream); }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2) var(--sp-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding: 4px 10px;
    font-weight: 600;
    letter-spacing: var(--tracking);
    color: var(--c-cream);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  nav a:hover {
    color: var(--c-cream);
    border-bottom-color: var(--c-sage);
  }
  nav a[aria-current='page'] {
    font-weight: 700;
    border-bottom-color: var(--c-text);
  }
  nav a[aria-current='page']:hover { border-bottom-color: var(--c-sage); }

  @media (max-width: 48rem) {
    .bar {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    ul { gap: var(--sp-1) var(--sp-2); }
  }
</style>
