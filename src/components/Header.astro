---
import { site } from '../site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {site.nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--rule);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    padding-block: var(--sp-4);
  }
  .brand {
    font-family: var(--ff-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--c-text);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding-block: var(--sp-2);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  nav a:hover { color: var(--c-text); }
  nav a[aria-current='page'] {
    color: var(--c-accent);
    border-bottom-color: var(--c-accent);
  }
  @media (max-width: 30rem) {
    .bar { flex-direction: column; align-items: flex-start; }
    ul { gap: var(--sp-1) var(--sp-4); }
  }
</style>
