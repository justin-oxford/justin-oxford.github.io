---
import StatusBadge from './StatusBadge.astro';
import TagChip from './TagChip.astro';
import DateRange from './DateRange.astro';

interface Props {
  title: string;
  summary: string;
  href: string;
  status: 'active' | 'archived' | 'shelved';
  started: string;
  ended?: string;
  tags?: string[];
  /** Heading level for the title; h3 inside a section. */
  headingLevel?: 'h2' | 'h3';
  /** Link each tag to its /projects/tag/<id>/ page. */
  linkTags?: boolean;
  /** Dev-only: marks an unpublished draft. */
  draft?: boolean;
}
const { title, summary, href, status, started, ended, tags = [], headingLevel: H = 'h3', linkTags = true, draft = false } = Astro.props;
---

<article class:list={['card', { draft }]}>
  <div class="meta">
    <DateRange start={started} end={ended} />
    <span class="badges">
      {draft && <span class="draft-tag">Draft</span>}
      <StatusBadge status={status} />
    </span>
  </div>
  <H class="title"><a href={href}>{title}</a></H>
  <p class="summary">{summary}</p>
  {tags.length > 0 && (
    <ul class="tags" aria-label="Tags">
      {tags.map((t) => <li><TagChip id={t} href={linkTags ? `/projects/tag/${t}/` : undefined} /></li>)}
    </ul>
  )}
</article>

<style>
  /* Old site featured item: 20px corners, soft diagonal gradient,
     lavender-gray border and underlined title on hover */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5);
    /* old: lighten($theme-black, 20) → 15; toned down so summary text keeps 4.5:1 contrast */
    background: linear-gradient(155deg, #3a3a3a 0%, var(--c-surface) 100%);
    border: 1.5px solid transparent;
    border-radius: var(--radius);
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--c-secondary);
  }
  .card:hover .title a { text-decoration: underline; }
  .card.draft { border: 1.5px dashed var(--c-terracotta); }
  .badges { display: inline-flex; align-items: center; gap: var(--sp-2); }
  .draft-tag {
    padding: 2px 10px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    color: var(--c-bg);
    background: var(--c-terracotta);
    border-radius: var(--radius-pill);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .title a {
    color: var(--c-text);
    text-decoration: none;
  }
  /* whole card is clickable via the title link */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible { outline: none; }
  .card:has(.title a:focus-visible) { outline: 2px solid var(--c-focus); outline-offset: 3px; }
  .summary {
    margin: 0;
    color: var(--c-secondary);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: auto 0 0;
    padding: 0;
    list-style: none;
    /* sit above the card-wide title link so tag links stay clickable */
    position: relative;
    z-index: 1;
  }
</style>
