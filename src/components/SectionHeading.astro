---
interface Props {
  /** Heading level; defaults to h2. */
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
}
const { as: Heading = 'h2', id } = Astro.props;
---

<Heading class="section-heading" id={id}><slot /></Heading>

<style>
  /* Old site panel title: lavender, semibold, with a divider underneath */
  .section-heading {
    margin: 0 0 var(--sp-5);
    padding-bottom: var(--sp-3);
    font-size: var(--fs-2xl);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--c-primary);
    border-bottom: var(--rule);
  }
</style>
