---
interface Props {
  status: 'active' | 'archived' | 'shelved';
}
const { status } = Astro.props;
const labels = { active: 'Active', archived: 'Archived', shelved: 'Shelved' } as const;
---

<span class:list={['badge', status]}><span class="lamp" aria-hidden="true"></span>{labels[status]}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-text-muted);
    white-space: nowrap;
  }
  /* small indicator lamp, like an annunciator light */
  .lamp {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    border: 1px solid currentColor;
  }
  .active { color: var(--c-signal); }
  .active .lamp { background: var(--c-signal); box-shadow: 0 0 6px color-mix(in srgb, var(--c-signal) 60%, transparent); }
  .archived .lamp { background: var(--c-text-muted); }
  .shelved .lamp { background: transparent; }
</style>
