---
interface Props {
  status: 'active' | 'archived' | 'shelved';
}
const { status } = Astro.props;
const labels = { active: 'Active', archived: 'Archived', shelved: 'Shelved' } as const;
---

<span class:list={['badge', status]}><span class="dot" aria-hidden="true"></span>{labels[status]}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 2px 12px 2px 10px;
    font-size: 0.6875rem; /* 11px, like the old tag pills */
    font-weight: 600;
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    background: var(--c-chip);
    color: var(--c-text-muted);
    white-space: nowrap;
  }
  .dot {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: currentColor;
  }
  .active { color: var(--c-sage); }
  .shelved .dot { background: transparent; border: 1.5px solid var(--c-terracotta); }
</style>
