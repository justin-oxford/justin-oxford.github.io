---
import { getEntry } from 'astro:content';

interface Props {
  /** Tag id from src/data/tags.yaml */
  id: string;
  /** Link target; plain text chip when omitted. */
  href?: string;
  /** Marks the chip as the current filter. */
  current?: boolean;
  /** Optional count shown after the label. */
  count?: number;
}
const { id, href, current = false, count } = Astro.props;
const tag = await getEntry('tags', id);
const label = tag?.data.label ?? id;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['chip', { current }]} href={href} aria-current={current ? 'page' : undefined}>
  {label}{count !== undefined && <span class="count">{count}</span>}
</Tag>

<style>
  /* Old site tag pill: rounded, slightly lighter than the panel, 11px semibold */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 4px 14px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--c-text-muted);
    background: var(--c-chip);
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
  }
  a.chip:hover {
    color: var(--c-text);
    border-color: var(--c-secondary);
  }
  .chip.current {
    color: var(--c-bg);
    background: var(--c-secondary);
  }
  .chip.current:hover { color: var(--c-bg); }
  .count { opacity: 0.8; }
</style>
