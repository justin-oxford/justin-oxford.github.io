---
import { getEntry } from 'astro:content';

interface Props {
  /** Tag id from src/data/tags.yaml */
  id: string;
  /** Link target; plain text chip when omitted. */
  href?: string;
}
const { id, href } = Astro.props;
const tag = await getEntry('tags', id);
const label = tag?.data.label ?? id;
const Tag = href ? 'a' : 'span';
---

<Tag class="chip" href={href}>{label}</Tag>

<style>
  /* Old site tag pill: rounded, slightly lighter than the panel, 11px semibold */
  .chip {
    display: inline-block;
    padding: 4px 14px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--c-text-muted);
    background: var(--c-chip);
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
  }
  a.chip:hover {
    color: var(--c-text);
    border-color: var(--c-secondary);
  }
</style>
