---
// Design system reference. noindex, not in the nav. Removed in "Launch polish".
import { Font } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TagChip from '../components/TagChip.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Button from '../components/Button.astro';
import DateRange from '../components/DateRange.astro';

const colors = [
  ['--c-bg', 'Background', 'Warm off-black'],
  ['--c-surface', 'Surface', 'Cards, panels'],
  ['--c-surface-2', 'Surface 2', 'Hover, inset'],
  ['--c-rule', 'Rule', 'Hairlines, minor ticks'],
  ['--c-rule-strong', 'Rule strong', 'Borders, major ticks'],
  ['--c-text', 'Text', 'Cream'],
  ['--c-text-muted', 'Text muted', 'Secondary text'],
  ['--c-accent', 'Accent', 'Amber: links, primary'],
  ['--c-accent-strong', 'Accent strong', 'Hover, focus'],
  ['--c-signal', 'Signal', 'Active status only'],
];
const sizes = ['3xl', '2xl', 'xl', 'lg', 'base', 'sm', 'xs'];
const space = [1, 2, 3, 4, 5, 6, 7, 8];

// Sample data for the component demos (wording from the Content Model card).
const sample = {
  title: 'JavaScript Racing',
  summary: 'In-browser F1-style racing game with tyre wear, fuel burn, and sector timing.',
  href: '#components',
  status: 'archived' as const,
  started: '2019-06',
  ended: '2019-08',
  tags: ['javascript', 'game-dev', 'physics'],
};

const pairings = [
  {
    key: 'a',
    name: 'A · Fraunces + Source Sans 3',
    note: 'Warm, slightly old-style serif headings over a plain, readable sans. Weathered and literary. Current default.',
  },
  {
    key: 'b',
    name: 'B · Barlow Condensed + Barlow',
    note: 'Condensed, signage-like headings (think panel placards and airport wayfinding) over a matching sans. More technical.',
  },
];
---

<BaseLayout title="Styleguide" description="Design tokens and components for justinoxford.com." noindex>
  <Fragment slot="head">
    <Font cssVariable="--font-display-b" />
    <Font cssVariable="--font-body-b" />
  </Fragment>

  <div class="container sg">
    <header class="intro">
      <p class="eyebrow">Internal · not indexed</p>
      <h1>Styleguide</h1>
      <p class="muted">
        Direction: dark, warm, and understated, like a well-worn instrument panel or a chronograph dial.
        Every page is built from these tokens and components.
      </p>
    </header>

    <!-- Colors -->
    <section aria-labelledby="colors">
      <SectionHeading index="01" id="colors">Color</SectionHeading>
      <ul class="swatches">
        {colors.map(([v, name, use]) => (
          <li>
            <span class="swatch" style={`background: var(${v})`}></span>
            <span class="sw-name">{name}</span>
            <code class="sw-var">{v}</code>
            <span class="sw-use muted">{use}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Type -->
    <section aria-labelledby="type">
      <SectionHeading index="02" id="type">Type</SectionHeading>
      <h3 class="sub">Typeface pairing: pick one</h3>
      <div class="pairings">
        {pairings.map((p) => (
          <article class:list={['pairing', `pairing-${p.key}`]}>
            <p class="eyebrow">{p.name}</p>
            <p class="pair-display">Safe Travels</p>
            <p class="pair-body">
              A catalog of projects, writing, and an aviation career, set at body size for reading.{' '}
              <em>Italic for emphasis.</em>
            </p>
            <p class="mono pair-mono">CL-65 · 2019-06 → 2019-08 · 0123456789</p>
            <p class="muted pair-note">{p.note}</p>
          </article>
        ))}
      </div>
      <p class="muted small">Figures, dates, nav, and labels use <strong>IBM Plex Mono</strong> with tabular numerals in both options. All fonts are open-licensed and self-hosted.</p>

      <h3 class="sub">Scale</h3>
      <ul class="scale">
        {sizes.map((s) => (
          <li>
            <code class="muted">--fs-{s}</code>
            <span style={`font-size: var(--fs-${s}); font-family: ${['3xl', '2xl', 'xl', 'lg'].includes(s) ? 'var(--ff-display)' : 'var(--ff-body)'}`}>Weathered and confident</span>
          </li>
        ))}
      </ul>
      <p class="eyebrow">Eyebrow / label text</p>
    </section>

    <!-- Space -->
    <section aria-labelledby="space">
      <SectionHeading index="03" id="space">Space</SectionHeading>
      <ul class="space">
        {space.map((n) => (
          <li>
            <code class="muted">--sp-{n}</code>
            <span class="bar" style={`width: var(--sp-${n})`}></span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Components -->
    <section aria-labelledby="components">
      <SectionHeading index="04" id="components">Components</SectionHeading>

      <h3 class="sub">Project card</h3>
      <div class="cards">
        <ProjectCard {...sample} />
        <ProjectCard
          title="Sample active project"
          summary="Placeholder entry showing the active status and an open-ended date range."
          href="#components"
          status="active"
          started="2026-03"
          tags={['python', 'bot']}
        />
        <ProjectCard
          title="Sample shelved project"
          summary="Placeholder entry showing the shelved status."
          href="#components"
          status="shelved"
          started="2021-01"
          ended="2021-05"
          tags={['web']}
        />
      </div>

      <h3 class="sub">Status badge</h3>
      <div class="row">
        <StatusBadge status="active" />
        <StatusBadge status="archived" />
        <StatusBadge status="shelved" />
      </div>

      <h3 class="sub">Tag chip</h3>
      <div class="row">
        <TagChip id="javascript" />
        <TagChip id="game-dev" />
        <TagChip id="aviation" href="#components" />
        <span class="muted small">(the last one is a link)</span>
      </div>

      <h3 class="sub">Button</h3>
      <div class="row">
        <Button href="#components">Primary link</Button>
        <Button href="#components" variant="ghost">Ghost link</Button>
        <Button variant="ghost">Button element</Button>
      </div>

      <h3 class="sub">Date range</h3>
      <div class="row">
        <DateRange start="2019-06" end="2019-08" />
        <DateRange start={2017} end={2019} />
        <DateRange start="2026-03" />
      </div>

      <h3 class="sub">Section heading</h3>
      <SectionHeading as="h3">Without an index</SectionHeading>

      <h3 class="sub">Prose</h3>
      <div class="prose">
        <p>
          Body copy sits at a comfortable reading measure. <a href="#components">Links are amber</a> with a thin
          underline, and <code>inline code</code> uses the mono face.
        </p>
      </div>
    </section>

    <!-- Pairing B preview -->
    <section aria-labelledby="preview-b" class="pairing-b">
      <SectionHeading index="05" id="preview-b">Pairing B, applied</SectionHeading>
      <p class="muted">The same components with pairing B, for comparison.</p>
      <div class="cards">
        <ProjectCard {...sample} />
      </div>
    </section>

    <!-- Decisions -->
    <section aria-labelledby="decisions">
      <SectionHeading index="06" id="decisions">Open decisions</SectionHeading>
      <ul class="decisions">
        <li>Approve this direction, or share 2–3 reference sites.</li>
        <li>Dark only (current), or dark + light.</li>
        <li>Keep “Safe Travels” in the footer (currently on).</li>
        <li>Typeface pairing A or B.</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .sg { padding-block: var(--sp-7); }
  .intro { max-width: var(--w-content); margin-bottom: var(--sp-7); }
  section { margin-bottom: var(--sp-8); }
  .sub {
    margin: var(--sp-6) 0 var(--sp-4);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  .small { font-size: var(--fs-sm); }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--sp-4);
    margin: 0; padding: 0; list-style: none;
  }
  .swatches li { display: grid; gap: var(--sp-1); font-size: var(--fs-sm); }
  .swatch {
    height: 4rem;
    border: 1px solid var(--c-rule-strong);
    border-radius: var(--radius);
  }
  .sw-name { font-weight: 600; }
  .sw-var { font-size: var(--fs-xs); color: var(--c-text-muted); }
  .sw-use { font-size: var(--fs-xs); }

  .pairings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--sp-5);
    margin-bottom: var(--sp-4);
  }
  .pairing {
    padding: var(--sp-5);
    background: var(--c-surface);
    border: var(--rule);
    border-radius: var(--radius);
  }
  .pair-display {
    margin: var(--sp-3) 0;
    font-family: var(--ff-display);
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: var(--lh-tight);
  }
  .pair-body { font-family: var(--ff-body); }
  .pair-mono { font-size: var(--fs-sm); color: var(--c-accent); }
  .pair-note { font-size: var(--fs-sm); margin: 0; }

  /* Pairing overrides: custom properties cascade into component styles */
  .pairing-a {
    --ff-display: var(--font-display-a, Georgia), Georgia, serif;
    --ff-body: var(--font-body-a, system-ui), system-ui, sans-serif;
  }
  .pairing-b {
    --ff-display: var(--font-display-b, 'Arial Narrow'), 'Arial Narrow', sans-serif;
    --ff-body: var(--font-body-b, system-ui), system-ui, sans-serif;
    font-family: var(--ff-body);
  }

  .scale, .space { margin: 0; padding: 0; list-style: none; }
  .scale li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: var(--sp-2);
    border-bottom: var(--rule);
    overflow-wrap: anywhere;
  }
  .scale code, .space code { font-size: var(--fs-xs); }
  .space li { display: grid; grid-template-columns: 6rem 1fr; align-items: center; gap: var(--sp-4); padding-block: var(--sp-1); }
  .space .bar { height: 0.75rem; background: var(--c-accent); border-radius: 1px; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--sp-5);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
  }
  .prose { max-width: var(--w-content); }
  .decisions { padding-left: 1.2em; }
  .decisions li { margin-bottom: var(--sp-2); }

  @media (max-width: 30rem) {
    .scale li, .space li { grid-template-columns: 1fr; gap: var(--sp-1); }
  }
</style>
