---
// Design system reference. noindex, not in the nav. Removed in "Launch polish".
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TagChip from '../components/TagChip.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Button from '../components/Button.astro';
import DateRange from '../components/DateRange.astro';

// [token, name, old-site variable, use]
const colors = [
  ['--c-bg', 'Background', '$theme-black', 'Page background'],
  ['--c-surface', 'Surface', 'lighten(black, 5)', 'Panels, cards'],
  ['--c-surface-2', 'Surface 2', 'lighten(black, 10)', 'Hover'],
  ['--c-chip', 'Chip', 'lighten(black, 13)', 'Tag pills, badges'],
  ['--c-rule-strong', 'Divider', 'lighten(black, 20)', 'Rules, borders'],
  ['--c-charcoal', 'Charcoal', '$dark-shade-col', 'Alternate panel'],
  ['--c-text', 'White', '$theme-white', 'Body text'],
  ['--c-cream', 'Cream', '$lite-shade-col', 'Nav, header'],
  ['--c-cream-warm', 'Warm cream', '$theme-lite', 'Big titles'],
  ['--c-text-muted', 'Muted', 'darken(white, 25)', 'Tags, dates'],
  ['--c-primary', 'Lavender', '$theme-primary', 'Links, buttons, headings'],
  ['--c-secondary', 'Lavender gray', '$theme-secondary', 'Descriptions, footer'],
  ['--c-sage', 'Sage', '$lite-accnt-col', 'Nav hover, Active'],
  ['--c-sage-dark', 'Sage dark', '$deegee-gr-drk', 'Alt button'],
  ['--c-terracotta', 'Terracotta', '$theme-accent_2', 'Shelved, TODOs'],
  ['--c-navy', 'Navy', '$main-brand-col', 'Spare'],
];
const sizes = ['3xl', '2xl', 'xl', 'lg', 'base', 'sm', 'xs'];
const weights = [300, 400, 500, 600, 700, 900];
const space = [1, 2, 3, 4, 5, 6, 7, 8];
const radii = [
  ['--radius-sm', '12px', 'Buttons'],
  ['--radius', '20px', 'Cards'],
  ['--radius-lg', '30px', 'Panels'],
  ['--radius-pill', '100px', 'Tags'],
];

// Sample data for the component demos (wording from the Content Model card).
const sample = {
  title: 'JavaScript Racing',
  summary: 'In-browser F1-style racing game with tyre wear, fuel burn, and sector timing.',
  href: '#components',
  status: 'archived' as const,
  started: '2019-06',
  ended: '2019-08',
  tags: ['javascript', 'game-dev', 'physics'],
};
---

<BaseLayout title="Styleguide" description="Design tokens and components for justinoxford.com." noindex>
  <div class="container sg">
    <header class="intro">
      <p class="eyebrow">Internal · not indexed</p>
      <h1>Styleguide</h1>
      <p class="muted">
        Carried over from the old site: near-black and charcoal, lavender and sage accents, cream and white
        text, Montserrat throughout, and generously rounded corners.
      </p>
    </header>

    <section aria-labelledby="colors">
      <SectionHeading id="colors">Color</SectionHeading>
      <ul class="swatches">
        {colors.map(([v, name, old, use]) => (
          <li>
            <span class="swatch" style={`background: var(${v})`}></span>
            <span class="sw-name">{name}</span>
            <code class="sw-var">{v}</code>
            <span class="sw-old">{old}</span>
            <span class="sw-use">{use}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="type">
      <SectionHeading id="type">Type</SectionHeading>
      <p class="muted">Montserrat, self-hosted. Tabular figures site-wide so dates line up.</p>

      <h3 class="sub">Weights</h3>
      <ul class="weights">
        {weights.map((w) => (
          <li style={`font-weight: ${w}`}><code>{w}</code> Safe Travels</li>
        ))}
      </ul>

      <h3 class="sub">Headings</h3>
      <div class="panel">
        <p class="h1-demo">Justin Oxford</p>
        <h2 class="h2-demo">Panel title (h2)</h2>
        <h3>Item title (h3)</h3>
        <p>Body text in white at 16px. <a href="#type">Links are lavender</a>, and <em>italic is real italic</em>.</p>
        <p class="muted">Descriptions use lavender gray.</p>
        <p class="eyebrow">Small label text</p>
      </div>

      <h3 class="sub">Scale</h3>
      <ul class="scale">
        {sizes.map((s) => (
          <li>
            <code>--fs-{s}</code>
            <span style={`font-size: var(--fs-${s}); font-weight: ${['3xl', '2xl'].includes(s) ? 700 : 400}`}>Safe Travels</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="shape">
      <SectionHeading id="shape">Shape and space</SectionHeading>
      <ul class="radii">
        {radii.map(([v, px, use]) => (
          <li>
            <span class="radius-demo" style={`border-radius: var(${v})`}></span>
            <code>{v}</code>
            <span class="muted">{px} · {use}</span>
          </li>
        ))}
      </ul>
      <ul class="space">
        {space.map((n) => (
          <li>
            <code>--sp-{n}</code>
            <span class="bar" style={`width: var(--sp-${n})`}></span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="components">
      <SectionHeading id="components">Components</SectionHeading>

      <h3 class="sub">Project card</h3>
      <div class="cards">
        <ProjectCard {...sample} />
        <ProjectCard
          title="Sample active project"
          summary="Placeholder entry showing the active status and an open-ended date range."
          href="#components"
          status="active"
          started="2026-03"
          tags={['python', 'bot']}
        />
        <ProjectCard
          title="Sample shelved project"
          summary="Placeholder entry showing the shelved status."
          href="#components"
          status="shelved"
          started="2021-01"
          ended="2021-05"
          tags={['web']}
        />
      </div>

      <h3 class="sub">Status badge</h3>
      <div class="row">
        <StatusBadge status="active" />
        <StatusBadge status="archived" />
        <StatusBadge status="shelved" />
      </div>

      <h3 class="sub">Tag chip</h3>
      <div class="row">
        <TagChip id="javascript" />
        <TagChip id="game-dev" />
        <TagChip id="aviation" href="#components" />
        <span class="muted small">(the last one is a link)</span>
      </div>

      <h3 class="sub">Button</h3>
      <div class="row">
        <Button href="#components">Primary</Button>
        <Button href="#components" variant="alt">Alt</Button>
        <Button variant="ghost">Ghost</Button>
      </div>

      <h3 class="sub">Date range</h3>
      <div class="row">
        <DateRange start="2019-06" end="2019-08" />
        <DateRange start={2017} end={2019} />
        <DateRange start="2026-03" />
      </div>

      <h3 class="sub">Section heading</h3>
      <SectionHeading as="h3">Section heading</SectionHeading>
    </section>

    <section aria-labelledby="decisions">
      <SectionHeading id="decisions">Open decisions</SectionHeading>
      <ul class="decisions">
        <li>Dark only (current), or dark + light.</li>
        <li>Keep “Safe Travels” in the footer (currently on).</li>
        <li>Domain email address for the footer.</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .sg { padding-block: var(--sp-6) var(--sp-7); }
  .intro { max-width: var(--w-content); margin-bottom: var(--sp-7); }
  section { margin-bottom: var(--sp-8); }
  .sub {
    margin: var(--sp-6) 0 var(--sp-4);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    color: var(--c-secondary);
  }
  .small { font-size: var(--fs-sm); }
  code { color: var(--c-text-muted); font-size: var(--fs-xs); }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: var(--sp-5) var(--sp-4);
    margin: 0; padding: 0; list-style: none;
  }
  .swatches li { display: grid; gap: 2px; font-size: var(--fs-sm); }
  .swatch {
    height: 4rem;
    margin-bottom: var(--sp-2);
    border: 1px solid var(--c-rule-strong);
    border-radius: var(--radius-sm);
  }
  .sw-name { font-weight: 600; }
  .sw-old { font-size: var(--fs-xs); color: var(--c-secondary); }
  .sw-use { font-size: var(--fs-xs); color: var(--c-text-muted); }

  .weights { margin: 0; padding: 0; list-style: none; font-size: var(--fs-xl); }
  .weights li { display: flex; align-items: baseline; gap: var(--sp-4); }
  .weights code { width: 2.5rem; }

  .h1-demo {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-3xl);
    font-weight: 900;
    letter-spacing: var(--tracking-title);
    line-height: var(--lh-tight);
    color: var(--c-cream-warm);
  }

  .scale, .space, .radii { margin: 0; padding: 0; list-style: none; }
  .scale li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: var(--sp-2);
    border-bottom: var(--rule);
    overflow-wrap: anywhere;
  }
  .radii {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--sp-5);
    margin-bottom: var(--sp-6);
  }
  .radii li { display: grid; gap: var(--sp-1); font-size: var(--fs-sm); }
  .radius-demo {
    height: 4rem;
    margin-bottom: var(--sp-2);
    background: var(--c-surface);
    border: 1.5px solid var(--c-secondary);
  }
  .space li { display: grid; grid-template-columns: 6rem 1fr; align-items: center; gap: var(--sp-4); padding-block: var(--sp-1); }
  .space .bar { height: 0.75rem; background: var(--c-primary); border-radius: 4px; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--sp-5);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
  }
  .decisions { padding-left: 1.2em; }
  .decisions li { margin-bottom: var(--sp-2); }

  @media (max-width: 30rem) {
    .scale li, .space li { grid-template-columns: 1fr; gap: var(--sp-1); }
  }
</style>
